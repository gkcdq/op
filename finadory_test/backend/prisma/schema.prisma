generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Publication {
  id          String   @id
  issuer      String?
  isin        String?
  cac40       Boolean  @default(false)
  type        String?
  subtype     String?
  status      String?
  relatedTo   String?  @map("related_to")
  title       String?
  publishedAt DateTime @map("published_at")
  url         String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([publishedAt(sort: Desc)])
  @@index([subtype])
  @@index([issuer])
  @@map("publications")
}

model LlmVerification {
  id            Int      @id @default(autoincrement())
  isin          String
  publishedAt   DateTime @map("published_at")
  documentUrl   String   @map("document_url")
  sourceHash    String   @default("") @map("source_hash")
  promptVersion String   @map("prompt_version")
  model         String
  status        String
  briefJson     Json?    @map("brief_json")
  verifStatus   String?  @map("verif_status")
  error         String?
  attempts      Int      @default(1)
  generatedAt   DateTime @default(now()) @map("generated_at")

  @@unique([isin, publishedAt, documentUrl, sourceHash, promptVersion, model], name: "cle_unique")
  @@map("llm")
}